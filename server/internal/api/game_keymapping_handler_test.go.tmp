func TestGetGameKeyMapping_NotFound(t *testing.T) {
	database, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	defer cleanup()
	token := registerAndGetToken(t, router)

	// Create a game to reference
	game := db.Game{ConsoleID: 1, Title: "Test Game", FileName: "test.nes", FilePath: "/roms/test.nes"}
	database.Create(&game)

	w := httptest.NewRecorder()
	req := httptest.NewRequest("GET", fmt.Sprintf("/api/user/games/%d/keymapping", game.ID), nil)
	req.Header.Set("Authorization", "Bearer "+token)
	router.ServeHTTP(w, req)
	assert.Equal(t, http.StatusNotFound, w.Code)
}

func TestUpdateGameKeyMapping_CreateNew(t *testing.T) {
	database, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	token := registerAndGetToken(t, router)

	// Create a game
	game := db.Game{ConsoleID: 1, Title: "Test Game", FileName: "test.nes", FilePath: "/roms/test.nes"}
	database.Create(&game)

	mapping := map[string]string{"0": "96", "1": "97", "2": "98"}
	body, _ := json.Marshal(map[string]interface{}{
		"customMapping": mapping,
	})
	w := httptest.NewRecorder()
	req := httptest.NewRequest("PUT", fmt.Sprintf("/api/user/games/%d/keymapping", game.ID), bytes.NewReader(body))
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(w, req)
	assert.Equal(t, http.StatusOK, w.Code)

	var resp map[string]interface{}
	err := json.Unmarshal(w.Body.Bytes(), &resp)
	require.NoError(t, err)
	assert.Equal(t, float64(game.ID), resp["gameId"])
	customMapping := resp["customMapping"].(map[string]interface{})
	assert.Equal(t, "96", customMapping["0"])
	assert.Equal(t, "97", customMapping["1"])
	assert.Equal(t, "98", customMapping["2"])
}

func TestUpdateGameKeyMapping_UpdateExisting(t *testing.T) {
	database, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	token := registerAndGetToken(t, router)

	// Create a game
	game := db.Game{ConsoleID: 1, Title: "Test Game", FileName: "test.nes", FilePath: "/roms/test.nes"}
	database.Create(&game)

	// Create initial mapping
	mapping := map[string]string{"0": "96", "1": "97"}
	body, _ := json.Marshal(map[string]interface{}{"customMapping": mapping})
	w := httptest.NewRecorder()
	req := httptest.NewRequest("PUT", fmt.Sprintf("/api/user/games/%d/keymapping", game.ID), bytes.NewReader(body))
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(w, req)
	require.Equal(t, http.StatusOK, w.Code)

	// Update mapping
	updatedMapping := map[string]string{"0": "100", "1": "101", "3": "102"}
	body, _ = json.Marshal(map[string]interface{}{"customMapping": updatedMapping})
	w = httptest.NewRecorder()
	req = httptest.NewRequest("PUT", fmt.Sprintf("/api/user/games/%d/keymapping", game.ID), bytes.NewReader(body))
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(w, req)
	assert.Equal(t, http.StatusOK, w.Code)

	var resp map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &resp)
	customMapping := resp["customMapping"].(map[string]interface{})
	assert.Equal(t, "100", customMapping["0"])
	assert.Equal(t, "101", customMapping["1"])
	assert.Equal(t, "102", customMapping["3"])
	_, has2 := customMapping["2"]
	assert.False(t, has2, "key 2 should not exist in the updated mapping")
}

