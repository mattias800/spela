func TestSharedSession_Delete_OwnerCanDelete(t *testing.T) {
	database, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	token := registerAndGetToken(t, router)

	var console db.Console
	database.First(&console)
	game := db.Game{ConsoleID: console.ID, Title: "Delete Game", FileName: "test.nes", FilePath: "/tmp/test.nes", FileSize: 100}
	database.Create(&game)
	gameID := fmt.Sprintf("%d", game.ID)

	ss := createSharedSession(t, router, token, gameID, "Delete Me")
	sharedSessionID := ss["id"].(string)

	w := httptest.NewRecorder()
	req := httptest.NewRequest("DELETE", "/api/shared-sessions/"+sharedSessionID, nil)
	req.Header.Set("Authorization", "Bearer "+token)
	router.ServeHTTP(w, req)
	assert.Equal(t, http.StatusOK, w.Code)

	// Verify it's gone
	w = httptest.NewRecorder()
	req = httptest.NewRequest("GET", "/api/shared-sessions/"+sharedSessionID, nil)
	req.Header.Set("Authorization", "Bearer "+token)
	router.ServeHTTP(w, req)
	assert.Equal(t, http.StatusNotFound, w.Code)
}

func TestSharedSession_Delete_MemberCannotDelete(t *testing.T) {
