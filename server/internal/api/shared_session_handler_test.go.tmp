// --- Helper functions ---

// registerSecondUser registers a second user and returns their access token.
func registerSecondUser(t *testing.T, router http.Handler, ownerToken string) string {
	t.Helper()
	return createNonOwnerUser(t, router, ownerToken, "player2", "player2@example.com", "password123")
}

// registerNamedUser registers a user with the given username and returns their access token.
func registerNamedUser(t *testing.T, router http.Handler, ownerToken, username string) string {
	t.Helper()
	return createNonOwnerUser(t, router, ownerToken, username, username+"@example.com", "password123")
}

// createSharedSession creates a shared session via API and returns the response map.
func createSharedSession(t *testing.T, router http.Handler, token, gameID, name string) map[string]interface{} {
	t.Helper()
	body, _ := json.Marshal(map[string]string{
		"gameId": gameID,
		"name":   name,
	})
	w := httptest.NewRecorder()
	req := httptest.NewRequest("POST", "/api/shared-sessions", bytes.NewReader(body))
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(w, req)
	require.Equal(t, http.StatusCreated, w.Code)

	var resp map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &resp)
	return resp
}

// inviteAndAcceptSharedSession invites a user to a shared session and has them accept it.
func inviteAndAcceptSharedSession(t *testing.T, router http.Handler, ownerToken, inviteeToken, sharedSessionID, inviteeUsername string) {
	t.Helper()

	// Invite
	body, _ := json.Marshal(map[string]string{"username": inviteeUsername})
	w := httptest.NewRecorder()
	req := httptest.NewRequest("POST", "/api/shared-sessions/"+sharedSessionID+"/invites", bytes.NewReader(body))
	req.Header.Set("Authorization", "Bearer "+ownerToken)
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(w, req)
	require.Equal(t, http.StatusCreated, w.Code)

	// Get the invite ID from the invitee's list
	w = httptest.NewRecorder()
	req = httptest.NewRequest("GET", "/api/user/shared-session-invites", nil)
	req.Header.Set("Authorization", "Bearer "+inviteeToken)
	router.ServeHTTP(w, req)
	require.Equal(t, http.StatusOK, w.Code)

	var invites []map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &invites)
	require.True(t, len(invites) > 0, "should have at least one invite")

	inviteID := invites[0]["id"].(string)

	// Accept
	w = httptest.NewRecorder()
	req = httptest.NewRequest("POST", "/api/user/shared-session-invites/"+inviteID+"/accept", nil)
	req.Header.Set("Authorization", "Bearer "+inviteeToken)
	router.ServeHTTP(w, req)
	require.Equal(t, http.StatusOK, w.Code)
}

// takeSharedSessionTurn acquires the turn and returns the turn token.
func takeSharedSessionTurn(t *testing.T, router http.Handler, token, sharedSessionID string) string {
	t.Helper()
	w := httptest.NewRecorder()
	req := httptest.NewRequest("POST", "/api/shared-sessions/"+sharedSessionID+"/take-turn", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	router.ServeHTTP(w, req)
	require.Equal(t, http.StatusOK, w.Code)

	var resp map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &resp)
	return resp["turnToken"].(string)
}

// --- CRUD tests ---

func TestSharedSession_Create(t *testing.T) {
	database, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	defer cleanup()
	token := registerAndGetToken(t, router)

	// Create a game
	var console db.Console
	database.First(&console)
	game := db.Game{ConsoleID: console.ID, Title: "Shared Session Game", FileName: "test.nes", FilePath: "/tmp/test.nes", FileSize: 100}
	database.Create(&game)
	gameID := fmt.Sprintf("%d", game.ID)

	resp := createSharedSession(t, router, token, gameID, "My Shared Session")

	assert.NotEmpty(t, resp["id"])
	assert.Equal(t, "My Shared Session", resp["name"])
	assert.Equal(t, gameID, resp["gameId"])
	assert.Equal(t, "active", resp["status"])
	assert.Equal(t, "Shared Session Game", resp["gameTitle"])
	assert.Equal(t, "apitest", resp["ownerUsername"])
	assert.Equal(t, float64(1), resp["memberCount"])

	// Verify members include the owner
	members := resp["members"].([]interface{})
	assert.Len(t, members, 1)
	member := members[0].(map[string]interface{})
	assert.Equal(t, "owner", member["role"])
	assert.Equal(t, "apitest", member["username"])
}

func TestSharedSession_Create_MissingFields(t *testing.T) {
	_, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	token := registerAndGetToken(t, router)

	tests := []struct {
		name string
		body map[string]string
	}{
		{"missing gameId", map[string]string{"name": "Test"}},
		{"missing name", map[string]string{"gameId": "1"}},
		{"both missing", map[string]string{}},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			body, _ := json.Marshal(tt.body)
			w := httptest.NewRecorder()
			req := httptest.NewRequest("POST", "/api/shared-sessions", bytes.NewReader(body))
			req.Header.Set("Authorization", "Bearer "+token)
			req.Header.Set("Content-Type", "application/json")
			router.ServeHTTP(w, req)
			assert.Equal(t, http.StatusBadRequest, w.Code)
		})
	}
}

