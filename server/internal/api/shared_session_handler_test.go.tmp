func TestSharedSession_Update_OwnerCanUpdate(t *testing.T) {
	database, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	token := registerAndGetToken(t, router)

	var console db.Console
	database.First(&console)
	game := db.Game{ConsoleID: console.ID, Title: "Update Game", FileName: "test.nes", FilePath: "/tmp/test.nes", FileSize: 100}
	database.Create(&game)
	gameID := fmt.Sprintf("%d", game.ID)

	ss := createSharedSession(t, router, token, gameID, "Original Name")
	sharedSessionID := ss["id"].(string)

	body, _ := json.Marshal(map[string]string{
		"name":   "Updated Name",
		"status": "completed",
	})
	w := httptest.NewRecorder()
	req := httptest.NewRequest("PUT", "/api/shared-sessions/"+sharedSessionID, bytes.NewReader(body))
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(w, req)
	assert.Equal(t, http.StatusOK, w.Code)

	var resp map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &resp)
	assert.Equal(t, "Updated Name", resp["name"])
	assert.Equal(t, "completed", resp["status"])
}

func TestSharedSession_Update_MemberCannotUpdate(t *testing.T) {
	database, cfg := setupTestEnv(t)
	router, cleanup := NewRouter(*cfg)
	token1 := registerAndGetToken(t, router)
	token2 := registerSecondUser(t, router, token1)

	var console db.Console
	database.First(&console)
	game := db.Game{ConsoleID: console.ID, Title: "Update Auth Game", FileName: "test.nes", FilePath: "/tmp/test.nes", FileSize: 100}
	database.Create(&game)
	gameID := fmt.Sprintf("%d", game.ID)

	ss := createSharedSession(t, router, token1, gameID, "Owner Session")
	sharedSessionID := ss["id"].(string)

	// Invite and accept user2
	inviteAndAcceptSharedSession(t, router, token1, token2, sharedSessionID, "player2")

	// User2 tries to update
	body, _ := json.Marshal(map[string]string{"name": "Hacked"})
	w := httptest.NewRecorder()
	req := httptest.NewRequest("PUT", "/api/shared-sessions/"+sharedSessionID, bytes.NewReader(body))
	req.Header.Set("Authorization", "Bearer "+token2)
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(w, req)
	assert.Equal(t, http.StatusForbidden, w.Code)
}

